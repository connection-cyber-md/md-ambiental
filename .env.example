# Copie para .env.local e preencha com as credenciais reais do projeto Supabase
# (staging ou produção). NUNCA commite o .env.local — já está no .gitignore.
#
# Este projeto ainda não está conectado a nenhum Supabase real (ver plano da Fase 1).
# Preencha estes valores quando o projeto md-ambiental-staging (ou produção) estiver
# vinculado via `supabase link`.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Somente uso em código server-side (route handlers, server actions).
# NUNCA importar em componente client. NUNCA commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
